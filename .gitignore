# env files
.env
.env*.local

# vercel
.vercel

# lokale Tooling-Artefakte (u.a. eine ~50 MB grosse Speicherdatei)
/.claude/
/.closedloop-ai/

# typescript
*.tsbuildinfo
next-env.d.ts

# Rohmaterial der Fotolieferungen, gehoert nicht ins Repo
/fotos-eingang/
